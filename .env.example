# XAI_API_KEY: Your xAI (https://console.x.ai/) or Groq (https://console.groq.com/) API key.
# Used by the /api/chat backend proxy.
# If omitted or left blank, LAKSHYA automatically runs in Demo Mode with realistic mentor replies.
XAI_API_KEY=""

# Optional model override
XAI_MODEL="grok-3-mini"

# GEMINI_API_KEY: Provided by AI Studio environment
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
